# Response headers for every file Cloudflare Pages serves from grandtourbureau.com (v690, the security audit L6).
# publish.js carries this file; nothing in the game reads it. The page's script and styles are inline, so they need
# 'unsafe-inline'; everything else is this site, the score server, and the Cloudflare analytics beacon if it is ever
# switched on. A CSP header can also refuse being framed by another site, which a meta tag cannot.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://grandtour-scores.martijnvaes01.workers.dev wss://grandtour-scores.martijnvaes01.workers.dev https://cloudflareinsights.com; worker-src 'self'; manifest-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(self), payment=()
  Strict-Transport-Security: max-age=31536000

# LONG CACHE FOR WHAT HAS A NAME THAT CHANGES WITH ITS CONTENT (8 October, the PageSpeed report). Everything the page asks
# for under /assets/ is named by a hash of its own text (flags, coast, zing, more, and the game script once it is a file
# of its own), so a new build is a new name and the old copy can never be wrong: a year, immutable. The fonts keep their
# names, so they get a month rather than a year. The page itself, sw.js and version.json are deliberately not here:
# they have to be asked for again every time, which is what Pages already does for them.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=2592000
# THE TWO FILES THAT ANNOUNCE A NEW BUILD MUST NEVER BE HELD (8 October): Pages' default for a non-page file is four hours,
# which is how sw.js and version.json came out. Browsers fetch a service worker past the HTTP cache anyway, but version.json
# is what the update notice reads, so both are told to be asked for again every time.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/version.json
  Cache-Control: public, max-age=0, must-revalidate

# THE PAGES.DEV COPY IS NOT A SECOND SITE (v691): Cloudflare serves the same files at grandtour.pages.dev, and Google
# should index only grandtourbureau.com. The canonical tags already say so; this says it louder.
https://grandtour.pages.dev/*
  X-Robots-Tag: noindex
